# Copie para .env.local (dev) e cadastre as mesmas variáveis na Vercel (produção).

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# Supabase → Project Settings → API. A service role NUNCA vai para o navegador.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Painel (/painel) — login básico do navegador
PAINEL_USER=admin
PAINEL_PASS=troque-por-uma-senha-longa

# Cakto → Integrações → Webhooks. Cadastre a URL:
#   https://seudominio.com.br/api/webhooks/cakto?token=<CAKTO_WEBHOOK_TOKEN>
# Se a Cakto também mandar um "secret" no corpo, coloque o mesmo valor em CAKTO_WEBHOOK_SECRET.
CAKTO_WEBHOOK_TOKEN=gere-um-token-aleatorio-longo
CAKTO_WEBHOOK_SECRET=
# true se a Cakto mandar valores em centavos (ex.: 990); false se mandar em reais (ex.: 9.9)
CAKTO_VALOR_EM_CENTAVOS=false

# Vercel Cron manda "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=gere-outro-token-aleatorio

# --- Contagem de seguidores (cada uma é opcional; sem ela, use o lançamento manual no painel) ---
# YouTube Data API v3 (Google Cloud → APIs → chave de API)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Instagram Graph API (conta Profissional ligada a uma Página do Facebook)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v24.0

# TikTok Display API (app em developers.tiktok.com com escopo user.info.stats)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Refresh token inicial; depois o sistema guarda os novos na tabela "integracoes"
TIKTOK_REFRESH_TOKEN=

# --- Publicação automática (painel local, Capítulo 09) — veja docs/PUBLICACAO.md ---
# YouTube Shorts pelo n8n: URL do webhook (https) e a chave enviada no cabeçalho X-Painel-Chave
N8N_WEBHOOK_PUBLICAR=
N8N_PAINEL_CHAVE=
# Opcional: URL do webhook de status (padrão: a de publicar trocando /publicar por /status)
N8N_WEBHOOK_STATUS=
# 1 quando o canal do YouTube já aceitar link externo na descrição (canal novo: deixe 0)
YOUTUBE_LINK_NA_DESCRICAO=0
# Instagram/TikTok pelo celular (ADB). Opcionais: caminho do adb.exe e serial (se tiver mais de um aparelho)
ADB_PATH=
ADB_SERIAL=

# Correio da colônia: o Claude escolhe os melhores comentários e escreve as respostas da Vega e da Lia
# (fabrica/correio.py). Crie em https://platform.claude.com → API Keys. Sem ela o episódio sai sem o quadro.
ANTHROPIC_API_KEY=
